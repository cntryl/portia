<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Portia.Accounts.Application/Portia.Accounts.Application.csproj" />
    <PackageReference Include="Cntryl.Portia.Testing" Version="$(PortiaSmokePackageVersion)" Condition="'$(PortiaSmokePackageVersion)' != ''" />
    <ProjectReference Include="../../../src/Portia.Testing/Portia.Testing.csproj" Condition="'$(PortiaSmokePackageVersion)' == ''" />
    <PackageReference Include="Cntryl.Conventions.Testing.Analyzers" Version="1.0.2" PrivateAssets="all" />
    <PackageReference Include="Cntryl.Conventions.Testing.CodeFixes" Version="1.0.2" PrivateAssets="all" />
    <PackageReference Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>
</Project>
