<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Description>Roslyn source generators and analyzers for Portia.</Description>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <!-- Shipped inside Cntryl.Portia.DependencyInjection under analyzers/dotnet/cs, never on its own. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Http/RequestHttpBindingGenerator.cs"/>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all"/>
  </ItemGroup>

  <ItemGroup>
    <AdditionalFiles Include="../../docs/AnalyzerReleases.Shipped.md"/>
    <AdditionalFiles Include="../../docs/AnalyzerReleases.Unshipped.md"/>
  </ItemGroup>
</Project>
