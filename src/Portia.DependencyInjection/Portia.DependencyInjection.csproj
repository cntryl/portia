<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Portia.DependencyInjection</PackageId>
    <AssemblyName>Portia.DependencyInjection</AssemblyName>
    <Description>Wires Portia's background runners (queue, live delivery, multi-tenancy, projectors, reactors) into a Microsoft.Extensions.Hosting host as IHostedServices.</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Portia.Abstractions/Portia.Abstractions.csproj" />
    <ProjectReference Include="../Portia.Core/Portia.Core.csproj" />
  </ItemGroup>
</Project>
