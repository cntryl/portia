<Project>
  <Import Project="../Directory.Build.props"/>

  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <Authors>cntryl</Authors>
    <RepositoryUrl>https://github.com/cntryl/portia</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/cntryl/portia</PackageProjectUrl>
    <PackageTags>cqrs;event-sourcing;mediator;aot;source-generator;aspnetcore</PackageTags>
    <!-- The SPDX expression is machine-readable, so a consumer's license scanner resolves it
         without the package carrying a copy of the text. LICENSE at the repository root is the
         unmodified license itself. -->
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Copyright>Copyright 2026 cntryl</Copyright>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageOutputPath>$(MSBuildThisFileDirectory)../artifacts/packages</PackageOutputPath>
    <IsAotCompatible Condition="'$(MSBuildProjectName)' != 'Portia.Generators' and '$(MSBuildProjectName)' != 'Portia.Analyzers' and '$(MSBuildProjectName)' != 'Portia.CodeFixes'">true</IsAotCompatible>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)../README.md" Pack="true" PackagePath="/"/>
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="$(MSBuildProjectDirectory)/PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="$(MSBuildProjectDirectory)/PublicAPI.Unshipped.txt" />
  </ItemGroup>
</Project>
