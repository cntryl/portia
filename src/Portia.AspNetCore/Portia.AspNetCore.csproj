<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Minimal API wiring for Portia requests.</Description>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi"/>
    <PackageReference Include="Microsoft.OpenApi"/>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Portia.Mcp.AspNetCore"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Portia.Abstractions/Portia.Abstractions.csproj"/>
    <ProjectReference Include="../Portia.DependencyInjection/Portia.DependencyInjection.csproj"/>
    <ProjectReference Include="../Portia.AspNetCore.Generators/Portia.AspNetCore.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all"/>
  </ItemGroup>

  <ItemGroup>
    <None Include="../Portia.AspNetCore.Generators/bin/$(Configuration)/netstandard2.0/Portia.AspNetCore.Generators.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false"/>
  </ItemGroup>
</Project>
