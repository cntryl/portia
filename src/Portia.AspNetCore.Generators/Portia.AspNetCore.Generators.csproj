<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Description>HTTP binding source generation owned by the Portia ASP.NET Core adapter.</Description>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all"/>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../Portia.Generators/Infrastructure/DiagnosticLocation.cs" Link="Infrastructure/DiagnosticLocation.cs"/>
    <Compile Include="../Portia.Generators/Infrastructure/GeneratedTypeShape.cs" Link="Infrastructure/GeneratedTypeShape.cs"/>
    <Compile Include="../Portia.Generators/Http/HttpBindingShape.cs" Link="Http/HttpBindingShape.cs"/>
    <Compile Include="../Portia.Generators/Http/InterceptableLocationModel.cs" Link="Http/InterceptableLocationModel.cs"/>
    <Compile Include="../Portia.Generators/Infrastructure/InterceptsLocationPolyfill.cs" Link="Infrastructure/InterceptsLocationPolyfill.cs"/>
    <Compile Include="../Portia.Generators/Infrastructure/IsExternalInit.cs" Link="Infrastructure/IsExternalInit.cs"/>
    <Compile Include="../Portia.Generators/Http/RequestHttpBindingGenerator.cs" Link="Http/RequestHttpBindingGenerator.cs"/>
  </ItemGroup>
  <ItemGroup>
    <AdditionalFiles Include="AnalyzerReleases.Shipped.md"/>
    <AdditionalFiles Include="AnalyzerReleases.Unshipped.md"/>
  </ItemGroup>
</Project>
