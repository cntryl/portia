<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="portia-local" value="../../artifacts/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <!-- The repository root maps every package to nuget.org, and a nearer packageSourceMapping
       replaces rather than extends it, so the local folder has to be mapped here too. Without
       this the smoke packages resolve only from a warm global cache and a cold restore fails. -->
  <packageSourceMapping>
    <packageSource key="portia-local">
      <package pattern="Portia.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
