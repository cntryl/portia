<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="portia-local" value="../../artifacts/packages" />
    <add key="cntryl" value="https://nuget.pkg.github.com/cntryl/index.json" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="portia-local">
      <package pattern="Cntryl.Portia.*" />
    </packageSource>
    <packageSource key="cntryl">
      <package pattern="Cntryl.Fitz.*" />
      <package pattern="Cntryl.LexKey" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
  <packageSourceCredentials>
    <cntryl>
      <add key="Username" value="%GITHUB_ACTOR%" />
      <add key="ClearTextPassword" value="%GITHUB_TOKEN%" />
    </cntryl>
  </packageSourceCredentials>
</configuration>
