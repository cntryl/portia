<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <PortiaSmokePackageVersion Condition="'$(PortiaSmokePackageVersion)' == ''">1.0.0-smoke</PortiaSmokePackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Cntryl.Portia.Mcp.Testing" Version="$(PortiaSmokePackageVersion)" />
  </ItemGroup>
</Project>
