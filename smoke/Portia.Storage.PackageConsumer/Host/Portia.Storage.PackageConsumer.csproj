<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <PortiaSmokePackageVersion Condition="'$(PortiaSmokePackageVersion)' == ''">1.0.0-smoke</PortiaSmokePackageVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Contracts/Portia.Storage.Contracts.csproj"/>
    <PackageReference Include="Cntryl.Portia.Storage.Aws" Version="$(PortiaSmokePackageVersion)"/>
  </ItemGroup>
</Project>
