<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Contracts/Portia.Storage.Contracts.csproj"/>
    <PackageReference Include="Cntryl.Portia.Storage.Aws" Version="$(PortiaSmokePackageVersion)" Condition="'$(PortiaSmokePackageVersion)' != ''" />
    <ProjectReference Include="../../../src/Portia.Storage.Aws/Portia.Storage.Aws.csproj" Condition="'$(PortiaSmokePackageVersion)' == ''" />
  </ItemGroup>
</Project>
