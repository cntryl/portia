<Project>
  <Target Name="BuildProjectReferencedAnalyzersForDesignTime"
          BeforeTargets="CoreCompile"
          Condition="'$(DesignTimeBuild)' == 'true'">
    <ItemGroup>
      <_ProjectReferencedAnalyzer Include="@(ProjectReference)"
                                  Condition="'%(ProjectReference.OutputItemType)' == 'Analyzer'"/>
    </ItemGroup>

    <MSBuild Projects="@(_ProjectReferencedAnalyzer)"
             Targets="Build"
             BuildInParallel="false"
             RemoveProperties="DesignTimeBuild;SkipCompilerExecution;ProvideCommandLineArgs;BuildingProject;BuildingInsideVisualStudio;TargetFramework;TargetFrameworks;RuntimeIdentifier;SelfContained"
             Properties="Configuration=$(Configuration)"
             Condition="'@(_ProjectReferencedAnalyzer)' != ''"/>
  </Target>

  <!-- PackageId is not checked: the SDK defaults it to AssemblyName before Pack runs, so the
       condition can never hold. The properties below are genuinely per-project. -->
  <Target Name="ValidatePackageMetadata" BeforeTargets="Pack" Condition="'$(IsPackable)' == 'true'">
    <Error Condition="'$(Description)' == ''" Text="Packable projects must define Description."/>
    <Error Condition="'$(Authors)' == ''" Text="Packable projects must define Authors."/>
    <Error Condition="'$(RepositoryUrl)' == ''" Text="Packable projects must define RepositoryUrl."/>
    <Error Condition="'$(PackageLicenseExpression)' == '' and '$(PackageLicenseFile)' == ''"
           Text="Packable projects must declare a license."/>
  </Target>
</Project>
