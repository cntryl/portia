<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <!-- RequestHttpBindingGenerator intercepts MapPortia* call sites to inline route/query/body
         binding — needed here so HttpBindingTests can exercise real generated bindings, not just
         the generator's own model, through a real ASP.NET Core TestServer. -->
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Cntryl.Portia.Generated</InterceptorsNamespaces>
    <LangVersion>15</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App"/>
    <None Include="../testconfig.json" Link="testconfig.json" CopyToOutputDirectory="PreserveNewest"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Cntryl.Conventions.Testing.Analyzers"/>
    <PackageReference Include="Cntryl.Conventions.Testing.CodeFixes"/>
    <PackageReference Include="Cntryl.Fitz.Core"/>
    <PackageReference Include="Cntryl.Fitz.Extensions"/>
    <PackageReference Include="coverlet.MTP" PrivateAssets="all"/>
    <PackageReference Include="Microsoft.AspNetCore.TestHost"/>
    <PackageReference Include="Microsoft.OpenApi"/>
    <PackageReference Include="Microsoft.OpenApi.YamlReader"/>
    <PackageReference Include="OpenTelemetry.Exporter.InMemory"/>
    <PackageReference Include="xunit.v3"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Portia.Operations.TestWorker/Portia.Operations.TestWorker.csproj" ReferenceOutputAssembly="false"/>
    <ProjectReference Include="../../src/Portia.Core/Portia.Core.csproj"/>
    <ProjectReference Include="../../src/Portia.DataProtection/Portia.DataProtection.csproj"/>
    <ProjectReference Include="../../src/Portia.DataProtection.Aws/Portia.DataProtection.Aws.csproj"/>
    <ProjectReference Include="../../src/Portia.Secrets.Aws/Portia.Secrets.Aws.csproj"/>
    <ProjectReference Include="../../src/Portia.Cassie/Portia.Cassie.csproj"/>
    <ProjectReference Include="../../src/Portia.Testing/Portia.Testing.csproj"/>
    <ProjectReference Include="../../src/Portia.Storage.Aws/Portia.Storage.Aws.csproj"/>
    <ProjectReference Include="../../src/Portia.Storage.Azure/Portia.Storage.Azure.csproj"/>
    <ProjectReference Include="../../src/Portia.Storage.Gcp/Portia.Storage.Gcp.csproj"/>
    <ProjectReference Include="../../src/Portia.Communications.Aws/Portia.Communications.Aws.csproj"/>
    <ProjectReference Include="../../src/Portia.Communications.Azure/Portia.Communications.Azure.csproj"/>
    <ProjectReference Include="../../src/Portia.Communications.Twilio/Portia.Communications.Twilio.csproj"/>
    <ProjectReference Include="../../src/Portia.Telemetry/Portia.Telemetry.csproj"/>
    <ProjectReference Include="../../src/Portia.DependencyInjection/Portia.DependencyInjection.csproj"/>
    <ProjectReference Include="../../src/Portia.AspNetCore/Portia.AspNetCore.csproj"/>
    <ProjectReference Include="../../src/Portia.Fitz/Portia.Fitz.csproj"/>
    <ProjectReference Include="../../eng/Portia.RepositoryTools/Portia.RepositoryTools.csproj"/>
    <ProjectReference Include="../../src/Portia.Jwt/Portia.Jwt.csproj"/>
    <ProjectReference Include="../../src/Portia.Generators/Portia.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
    <ProjectReference Include="../../src/Portia.AspNetCore.Generators/Portia.AspNetCore.Generators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
  </ItemGroup>
</Project>
