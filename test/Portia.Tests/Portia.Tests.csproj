<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- RequestHttpBindingGenerator intercepts MapPortia* call sites to inline route/query/body
         binding — needed here so HttpBindingTests can exercise real generated bindings, not just
         the generator's own model, through a real ASP.NET Core TestServer. -->
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Cntryl.Portia.Generated</InterceptorsNamespaces>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Cntryl.Fitz"/>
    <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.TestHost"/>
    <PackageReference Include="Microsoft.OpenApi"/>
    <PackageReference Include="Microsoft.OpenApi.YamlReader"/>
    <PackageReference Include="Microsoft.NET.Test.Sdk"/>
    <PackageReference Include="xunit"/>
    <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Portia.Core/Portia.Core.csproj"/>
    <ProjectReference Include="../../src/Portia.Testing/Portia.Testing.csproj"/>
    <ProjectReference Include="../../src/Portia.DependencyInjection/Portia.DependencyInjection.csproj"/>
    <ProjectReference Include="../../src/Portia.AspNetCore/Portia.AspNetCore.csproj"/>
    <ProjectReference Include="../../src/Portia.Fitz/Portia.Fitz.csproj"/>
    <ProjectReference Include="../../src/Portia.Jwt/Portia.Jwt.csproj"/>
    <ProjectReference Include="../../src/Portia.Generators/Portia.Generators.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"/>
  </ItemGroup>
  <ItemGroup>
    <!-- Portia's test doubles and conformance suites are their own namespace, so a consumer never
         sees them beside the production contracts. This project is entirely tests, so it opts in
         once here rather than in every file. -->
    <Using Include="Cntryl.Portia.Testing"/>
  </ItemGroup>

</Project>
