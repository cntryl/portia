<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <LangVersion>15</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Cntryl.Conventions.Testing.Analyzers"/>
    <PackageReference Include="Cntryl.Conventions.Testing.CodeFixes"/>
    <PackageReference Include="xunit.v3"/>
    <ProjectReference Include="../../src/Portia.Abstractions/Portia.Abstractions.csproj"/>
  </ItemGroup>
</Project>
