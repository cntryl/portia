#!/bin/sh

message_file=$1
awk '
BEGIN { allowed = "co-authored-by: dependabot[bot] <49699333+dependabot[bot]@users.noreply.github.com>" }
/^[[:space:]]*Co-authored-by:/ {
    line = tolower($0)
    sub(/\r$/, "", line)
    if (line != allowed) {
        exit 42
    }
}
' "$message_file"
status=$?
if [ "$status" -eq 42 ]; then
    echo 'Commit rejected: only Dependabot may be a co-author.' >&2
    exit 1
fi
if [ "$status" -ne 0 ]; then
    echo 'Commit rejected: could not validate co-author trailers.' >&2
    exit 1
fi
