<Project>
  <ItemGroup>
    <EditorConfigFiles Include="$(MSBuildThisFileDirectory)proofs/.editorconfig" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Portia.Tests'">
    <Compile Include="$(MSBuildThisFileDirectory)proofs/main/**/*.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'Portia.ConsumerTests'">
    <Compile Include="$(MSBuildThisFileDirectory)proofs/consumer/**/*.cs" />
  </ItemGroup>
</Project>
